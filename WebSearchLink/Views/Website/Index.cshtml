                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </main>

</body>
<script>
    const header = document.querySelector('.header-sticky');
    const homeMain = document.getElementById('home-main-height');
    const nav = document.getElementById('site-navigation');
    const navItems = document.querySelectorAll('.nav-header-link');
    const navHeight = header.offsetHeight;
    const homeMainHeight = homeMain.offsetHeight;
    console.log(navHeight);
    function toggleMenu() {
        const panel = document.getElementById("menuPanel");
        panel.style.display = (panel.style.display === "block") ? "none" : "block";
    }
</script>
<script src="~/asset_website/js/res_mobile.js"></script>

</html>