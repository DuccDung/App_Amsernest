</head>

<body>

    <div class="header-sticky">
        <header>
            <div class=" d-flex justify-content-between align-items-center mx-5 mt-1 text-white z-index-1000">
                <h1 class="home__header-name">Amsernest</h1>
                <nav>
                    <ul class="nav">
                        <li class="nav-item d-flex align-items-center">
                            <a class="nav-link text-white "
                               href="index.html">Information for:</a>
