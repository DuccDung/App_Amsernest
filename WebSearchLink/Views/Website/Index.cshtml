    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+Pro:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/asset_website/css/base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/asset_website/css/res_pc.css" asp-append-version="true">
    <link rel="stylesheet" href="~/asset_website/css/res_mobile_tablet.css" asp-append-version="true">
    <link rel="stylesheet" href="~/asset_website/css/res_mobile.css" asp-append-version="true">

    <!-- JS -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"
            integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous">
    </script>
    <script src="script.js" defer></script>

    <!-- Inline CSS -->
